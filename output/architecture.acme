System ELearningManagementSystem {
  Property view : String = "runtime";
  Property architectureStyle : String = "Microservices Architecture";
  Property source : String = "AI";
  Component UserService = new Component {
    Port in;
    Port out;
    Property responsibility : String = "Handles user registration, authentication, and profile management.";
    Property state : String = "stateless";
    Property scaling : String = "horizontal";
  }
  Component CourseService = new Component {
    Port in;
    Port out;
    Property responsibility : String = "Manages courses, lessons, and course enrollments.";
    Property state : String = "stateless";
    Property scaling : String = "horizontal";
  }
  Component VideoStreamingService = new Component {
    Port in;
    Port out;
    Property responsibility : String = "Streams video lectures to students.";
    Property state : String = "stateless";
    Property scaling : String = "horizontal";
  }
  Component ProgressTrackingService = new Component {
    Port in;
    Port out;
    Property responsibility : String = "Tracks student progress and grades.";
    Property state : String = "stateless";
    Property scaling : String = "horizontal";
  }
  Component NotificationService = new Component {
    Port in;
    Port out;
    Property responsibility : String = "Sends notifications to students and instructors.";
    Property state : String = "stateless";
    Property scaling : String = "horizontal";
  }
  Component DatabaseService = new Component {
    Port in;
    Port out;
    Property responsibility : String = "Manages data storage and retrieval for the E-Learning Management System.";
    Property state : String = "stateful";
    Property scaling : String = "vertical";
    Property consistency : String = "eventual";
    Property replication : String = "multi-node";
  }
  Attachment UserService.out to CourseService.in {
    Property delivery : String = "at-least-once";
    Property ordering : Boolean = false;
    Property backpressure : String = "bounded";
  }
  Attachment UserService.out to ProgressTrackingService.in {
    Property delivery : String = "at-least-once";
    Property ordering : Boolean = false;
    Property backpressure : String = "bounded";
  }
  Attachment CourseService.out to VideoStreamingService.in {
    Property delivery : String = "at-least-once";
    Property ordering : Boolean = true;
    Property backpressure : String = "bounded";
  }
  Attachment CourseService.out to ProgressTrackingService.in {
    Property delivery : String = "at-least-once";
    Property ordering : Boolean = false;
    Property backpressure : String = "bounded";
  }
  Attachment VideoStreamingService.out to NotificationService.in {
    Property delivery : String = "at-least-once";
    Property ordering : Boolean = false;
    Property backpressure : String = "bounded";
  }
  Attachment ProgressTrackingService.out to NotificationService.in {
    Property delivery : String = "at-least-once";
    Property ordering : Boolean = false;
    Property backpressure : String = "bounded";
  }
  Attachment NotificationService.out to DatabaseService.in {
    Property delivery : String = "at-least-once";
    Property ordering : Boolean = true;
    Property backpressure : String = "bounded";
  }
  Attachment CourseService.out to DatabaseService.in {
    Property delivery : String = "at-least-once";
    Property ordering : Boolean = true;
    Property backpressure : String = "bounded";
  }
  Attachment UserService.out to DatabaseService.in {
    Property delivery : String = "at-least-once";
    Property ordering : Boolean = true;
    Property backpressure : String = "bounded";
  }
  Attachment ProgressTrackingService.out to DatabaseService.in {
    Property delivery : String = "at-least-once";
    Property ordering : Boolean = true;
    Property backpressure : String = "bounded";
  }
  Attachment VideoStreamingService.out to DatabaseService.in {
    Property delivery : String = "at-least-once";
    Property ordering : Boolean = true;
    Property backpressure : String = "bounded";
  }
  Attachment NotificationService.out to DatabaseService.in {
    Property delivery : String = "at-least-once";
    Property ordering : Boolean = true;
    Property backpressure : String = "bounded";
  }
  Property resilience_pattern : String = "Retry, CircuitBreaker";
  Property delivery : String = "at-least-once";
  Property ordering : Boolean = false;
  Property authentication : String = "service-to-service";
  Property authorization : String = "RBAC";
}