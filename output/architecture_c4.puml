@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()
System_Boundary(system, "ELearningManagementSystem") {
  Container(UserService, "User Service", "Service", "Handle user registration, authentication, and profile management.")
  Container(CourseService, "Course Service", "Service", "Manage courses, lessons, and course enrollments.")
  Container(VideoStreamingService, "Video Streaming Service", "Service", "Stream video lectures and handle video playback.")
  Container(ProgressTrackingService, "Progress Tracking Service", "Service", "Track student progress and grades.")
  Container(NotificationService, "Notification Service", "Service", "Send notifications to students and instructors.")
  Container(APIGateway, "API Gateway", "REST API", "Handle incoming requests, route them to the appropriate service, and manage authentication.")
  ContainerDb(Database, "Database", "Database", "Store user, course, lesson, and progress data.")
}
Rel(APIGateway, UserService, "event", "Async")
Rel(APIGateway, CourseService, "event", "Async")
Rel(APIGateway, VideoStreamingService, "event", "Async")
Rel(APIGateway, ProgressTrackingService, "event", "Async")
Rel(APIGateway, NotificationService, "event", "Async")
Rel(UserService, Database, "call", "Sync")
Rel(CourseService, Database, "call", "Sync")
Rel(VideoStreamingService, Database, "call", "Sync")
Rel(ProgressTrackingService, Database, "call", "Sync")
Rel(NotificationService, Database, "call", "Sync")
Rel(APIGateway, Database, "call", "Sync")
Rel(UserService, ProgressTrackingService, "event", "Async")
Rel(CourseService, ProgressTrackingService, "event", "Async")
Rel(VideoStreamingService, ProgressTrackingService, "event", "Async")
Rel(NotificationService, ProgressTrackingService, "event", "Async")
Rel(ProgressTrackingService, NotificationService, "event", "Async")
@enduml