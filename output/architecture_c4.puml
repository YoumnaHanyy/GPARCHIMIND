@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()
System_Boundary(system, "OnlineFoodOrderingSystem") {
  Container(UserService, "User Service", "Service", "Handles user registration, authentication, and profile management.")
  Container(RestaurantService, "Restaurant Service", "Service", "Manages restaurant information, menus, and order processing.")
  Container(OrderService, "Order Service", "Service", "Processes food orders, handles payment, and tracks order status in real-time.")
  Container(PaymentGateway, "Payment Gateway", "REST API", "Facilitates online payments through various payment methods.")
  Container(NotificationService, "Notification Service", "Service", "Sends order notifications to users via email, SMS, or other channels.")
  ContainerDb(Database, "Database", "Database", "Stores and retrieves data for all components.")
  Container(APIGateway, "API Gateway", "REST API", "Routes incoming requests to the respective components and handles authentication.")
  Container(WebApplication, "Web Application", "Service", "Provides a user-friendly interface for users to interact with the system.")
}
Rel(APIGateway, UserService, "call", "Sync")
Rel(APIGateway, RestaurantService, "call", "Sync")
Rel(APIGateway, OrderService, "call", "Sync")
Rel(APIGateway, PaymentGateway, "call", "Sync")
Rel(APIGateway, NotificationService, "event", "Async")
Rel(UserService, Database, "call", "Sync")
Rel(RestaurantService, Database, "call", "Sync")
Rel(OrderService, Database, "call", "Sync")
Rel(PaymentGateway, Database, "call", "Sync")
Rel(NotificationService, Database, "call", "Sync")
Rel(OrderService, NotificationService, "event", "Async")
Rel(PaymentGateway, NotificationService, "event", "Async")
Rel(WebApplication, APIGateway, "call", "Sync")
@enduml