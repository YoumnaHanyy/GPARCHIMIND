@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()
System_Boundary(ResuFitPrecisionCVMatchingSystem, "ResuFit: Precision CV Matching System") {
  Container(AuthenticationService, "Authentication Service", "Service", "Handles user login and authentication")
  Container(LectureProcessor, "Lecture Processor", "Service", "Processes uploaded lectures for question generation")
  Container(FileConverter, "File Converter", "Service", "Converts uploaded files to text format")
  Container(TextExtractionModule, "Text Extraction Module", "Service", "Extracts relevant text from uploaded files for question generation")
  Container(QuestionGenerator, "Question Generator", "Service", "Generates questions based on extracted text and user input")
  Container(QuestionBankManager, "Question Bank Manager", "Service", "Stores and manages generated questions for future use")
  Container(DifficultyLevelService, "Difficulty Level Service", "Service", "Allows users to select the difficulty level of generated questions")
  Container(UserInterface, "User Interface", "Service", "Provides a user-friendly interface for users to interact with the system")
  ContainerDb(QuestionBankDatabase, "Question Bank Database", "Database", "Stores and manages generated questions in a database")
}
Rel(AuthenticationService, UserInterface, "event", "Async")
Rel(UserInterface, QuestionGenerator, "call", "Sync")
Rel(UserInterface, DifficultyLevelService, "call", "Sync")
Rel(QuestionGenerator, QuestionBankManager, "call", "Sync")
Rel(QuestionGenerator, QuestionBankDatabase, "call", "Sync")
Rel(FileConverter, TextExtractionModule, "call", "Sync")
Rel(TextExtractionModule, QuestionGenerator, "call", "Sync")
Rel(LectureProcessor, TextExtractionModule, "call", "Sync")
Rel(DifficultyLevelService, QuestionGenerator, "call", "Sync")
Rel(QuestionBankManager, QuestionBankDatabase, "call", "Sync")
@enduml